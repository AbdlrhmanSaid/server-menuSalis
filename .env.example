# =========================================================================
# Server Configuration | إعدادات الخادم
# =========================================================================
# The port the application server will run on (Default: 5000)
# المنفذ الذي سيعمل عليه الخادم (الافتراضي: 5000)
PORT=5000

# The environment mode (development, production, test)
# وضع بيئة العمل (development أو production أو test)
NODE_ENV=development


# =========================================================================
# CORS Configuration | إعدادات CORS
# =========================================================================
# Comma-separated list of allowed origins for CORS. Add multiple URLs separated by commas.
# قائمة بجميع العناوين المسموح لها بالاتصال بالخادم، مفصولة بفاصلة.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000


# =========================================================================
# Database Configuration | إعدادات قاعدة البيانات
# =========================================================================
# The following credentials are used in config/db.js to build the MongoDB Atlas URI:
# mongodb+srv://${DB_USER}:${DB_PASSWORD}@cluster0.9fimd.mongodb.net/${DB_NAME}
# البيانات التالية تستخدم لبناء رابط الاتصال بقاعدة بيانات MongoDB Atlas:

# MongoDB Database User | اسم مستخدم قاعدة البيانات
DB_USER=your_db_user

# MongoDB Database Password | كلمة مرور قاعدة البيانات
DB_PASSWORD=your_db_password

# MongoDB Database Name | اسم قاعدة البيانات
DB_NAME=your_db_name

# Optional/Fallback MongoDB connection string (Used in health check verification in server.js)
# رابط اتصال MongoDB اختياري (يستخدم للتحقق في مسار اختبار صحة الخادم في server.js)
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.9fimd.mongodb.net/your_db_name


# =========================================================================
# Security & Authentication | الحماية والتحقق
# =========================================================================
# Secret key used for signing and verifying JSON Web Tokens (JWT)
# المفتاح السري المستخدم لتشفير والتحقق من توكن JWT
JWT_SECRET=your_jwt_secret_key_here


# =========================================================================
# Cloudinary Configurations | إعدادات كلاوديناري لرفع الملفات
# =========================================================================
# Cloudinary account cloud name
# اسم السحابة الخاص بحساب كلاوديناري
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
# مفتاح API الخاص بكلاوديناري
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret
# المفتاح السري الخاص بكلاوديناري
CLOUDINARY_API_SECRET=your_cloudinary_api_secret



ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
